# infra/.env.prod.example — copy thành infra/.env.prod cho compose prod.
# KHÔNG commit infra/.env.prod (đã có trong .gitignore mở rộng).
#
# Khác .env dev (root):
# - hostname dùng tên service compose (postgres, kafka, mlflow), KHÔNG phải localhost
# - FRONTEND_ORIGIN có thể là * cho demo, hoặc URL cụ thể khi deploy

# --- Postgres ---
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_DB=monitoring

# --- Kafka ---
KAFKA_TOPIC_VITALS=patient-vitals
KAFKA_CONSUMER_GROUP=backend-consumer

# --- MLflow / Model ---
MODEL_NAME=sepsis-predictor
MODEL_ALIAS=production
MODEL_THRESHOLD=0.70

# --- App ---
FRONTEND_ORIGIN=*
DRIFT_FEATURES_THRESHOLD=0.30
LOG_LEVEL=INFO
