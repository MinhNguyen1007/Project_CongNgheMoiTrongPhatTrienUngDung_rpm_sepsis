# infra/.env.prod.example — copy thành infra/.env.prod cho compose prod/aws.
# KHÔNG commit infra/.env.prod (đã có trong .gitignore).
#
# Có 2 biến thể compose dùng chung file này:
#  - docker-compose.prod.yml (local full stack có Postgres container)
#  - docker-compose.aws.yml (EC2 + RDS + S3, KHÔNG có Postgres container)
#
# Khi deploy AWS: phải set DATABASE_URL + S3_DATA_BUCKET (xem block AWS bên dưới).

# ============================================================
# CHUNG (cả prod local + AWS)
# ============================================================

# --- Postgres credentials (chỉ dùng cho prod local có Postgres container) ---
# AWS deploy: BỎ QUA 3 biến này, dùng DATABASE_URL bên dưới.
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_DB=monitoring

# --- Kafka ---
KAFKA_TOPIC_VITALS=patient-vitals
KAFKA_CONSUMER_GROUP=backend-consumer

# --- MLflow / Model ---
MODEL_NAME=sepsis-predictor
MODEL_ALIAS=production
MODEL_THRESHOLD=0.70

# --- App ---
FRONTEND_ORIGIN=*
DRIFT_FEATURES_THRESHOLD=0.30
LOG_LEVEL=INFO

# ============================================================
# AWS DEPLOY (chỉ cần khi dùng docker-compose.aws.yml)
# ============================================================

# --- RDS Postgres ---
# Format: postgresql+asyncpg://<user>:<pass>@<rds-endpoint>:5432/<db>
# Endpoint lấy từ AWS Console → RDS → Databases → <instance> → Endpoint.
# Khi để trống → docker-compose.aws.yml backend sẽ FAIL khởi động.
DATABASE_URL=

# --- S3 bucket chứa PhysioNet data cho retrain ---
# Upload 1 lần từ laptop:
#   aws s3 sync ml/data/training_setA s3://<bucket>/physionet/training_setA/
#   aws s3 sync ml/data/training_setB s3://<bucket>/physionet/training_setB/
S3_DATA_BUCKET=
S3_DATA_PREFIX=physionet/

# --- AWS credentials ---
# Ưu tiên (recommended): GẮN IAM ROLE cho EC2 instance có quyền
#   s3:GetObject + s3:ListBucket trên bucket trên → BỎ TRỐNG 2 biến dưới.
# Fallback (dev/test): dán access key IAM user. NHỚ rotate sau demo.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
