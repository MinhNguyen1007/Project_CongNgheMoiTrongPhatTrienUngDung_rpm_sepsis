# MLflow tracking server. SQLite backend + local FS artifacts (đủ cho demo).
# Volume mount /mlflow → persist db + artifacts qua restart.
#
# Pin mlflow==2.22.0 khớp với requirements.txt backend để tránh schema mismatch.

FROM python:3.11-slim

# WHY libgomp1: mlflow.xgboost.load_model trên client (backend) cần, nhưng
# trên server chỉ cần khi serve model qua mlflow serving — ta không dùng.
# Giữ slim, chỉ install mlflow.
RUN pip install --no-cache-dir mlflow==2.22.0

# Volume mount point.
RUN mkdir -p /mlflow/artifacts
WORKDIR /mlflow

EXPOSE 5000

# WHY --serve-artifacts: artifact resolve qua tracking server, không cần
# client mount cùng FS. SQLite ở /mlflow/mlflow.db, artifact ở /mlflow/artifacts.
CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--serve-artifacts"]
