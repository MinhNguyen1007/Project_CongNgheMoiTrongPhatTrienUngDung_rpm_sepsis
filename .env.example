# ============================================================================
# .env.example — copy thành `.env` ở project root.
# Backend (FastAPI) load qua pydantic-settings, MLflow CLI đọc env trực tiếp.
# ============================================================================

# --- Database ---
# Local dev: chạy docker-compose ở infra/, postgres expose port 5432.
DATABASE_URL=postgresql+asyncpg://monitoring:monitoring@localhost:5432/monitoring

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_VITALS=patient-vitals
KAFKA_CONSUMER_GROUP=backend-consumer

# --- MLflow ---
# Local dev: file backend store. Production: dùng http://mlflow:5000.
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=sepsis-predictor
# Alias mới (MLflow 2.9+). Backend load qua URI models:/<MODEL_NAME>@<MODEL_ALIAS>.
MODEL_ALIAS=production
# Threshold cuối cùng từ notebook 02 (sweep ra 0.70 cho Utility tối đa).
MODEL_THRESHOLD=0.70

# --- Frontend CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Drift detection ---
# Tỷ lệ feature drift tối thiểu để trigger retrain. Evidently default 0.5 chặt quá.
DRIFT_FEATURES_THRESHOLD=0.3

# --- Logging ---
LOG_LEVEL=INFO
