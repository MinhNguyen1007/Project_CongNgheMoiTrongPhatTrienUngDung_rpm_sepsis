# Loại bloat khỏi Docker build context.
# Áp dụng cho mọi Dockerfile build từ project root.

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtualenv (host venv không vào image)
venv/
.venv/
env/

# Dataset + ML artifacts (mount vào container thay vì copy)
ml/data/training_setA/
ml/data/training_setB/
ml/data/*.csv
ml/data/*.parquet
ml/notebooks/mlruns/
mlruns/
mlartifacts/
*.pkl
*.joblib

# Notebooks (không cần trong runtime image)
ml/notebooks/
.ipynb_checkpoints/

# Frontend (build trong Dockerfile.frontend, không copy sẵn)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Env / secrets
.env
.env.local
.env.prod
*.pem
*.key

# Git + IDE + OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docs (không cần trong runtime)
*.md
README.md
CLAUDE.md

# Docker meta
infra/data/
infra/postgres-data/
